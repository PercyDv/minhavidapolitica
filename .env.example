# Copie para .env (cp .env.example .env) e troque TODAS as senhas. O .env não vai para o Git.

# Banco MySQL (docker-compose.yml)
MYSQL_ROOT_PASSWORD=troque-a-senha-root
MYSQL_DATABASE=minhavidapolitica
MYSQL_USER=mvp_user
MYSQL_PASSWORD=troque-a-senha-do-app
MYSQL_PORT=3307

# Administrador inicial do painel (criado só se não houver nenhum usuário). Senha com 8+ caracteres.
ADMIN_USERNAME=admin
ADMIN_NOME=Administrador
ADMIN_PASSWORD=troque-a-senha-admin

# Aplicação
SERVER_PORT=8080
# none na primeira execução; depois que tudo subir, use validate
JPA_DDL_AUTO=none
SWAGGER_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
